#nombre de la aplicacion
spring.application.name=ProMantenimiento
#puerto de la aplicacion
server.port=8085
#url del proyecto
server.servlet.context-path=/promantenimiento
#cadena de conexion
spring.datasource.url=jdbc:mysql://localhost:3307/bdpromantenimiento20262
#usuario de la bd
spring.datasource.username=root
#clave de la bd
spring.datasource.password=gean
#driver de mysql
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
# Firebase Admin SDK: clave privada local
firebase.credentials.path=D:/Usuario/Gean/Escritorio/Proyectos isil/Pro-mantenimiento/bdpromantenimiento-admin.json
# Almacenamiento de evidencias de incidencias
app.upload.dir=uploads/incidencias
# Tamaño máximo de cada archivo
spring.servlet.multipart.max-file-size=20MB
# Tamaño máximo de toda la petición multipart
spring.servlet.multipart.max-request-size=65MB


logging.level.org.springframework.security=DEBUG